---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getPlaygroundMeta } from '../lib/playground';

const thoughts = (await getPlaygroundMeta()).map((item) => ({
  label: item.client,
  href: `/playground/${item.slug}`,
}));

const email = 'hello@jamesreilly.design';
---

<BaseLayout
  title="About — James Reilly"
  description="James Reilly is a product designer. Founder of Aced-It."
>
  <Nav />
  <main id="main" class="about-page">
    <article class="about-page__shell">
      <div class="about-page__copy">
        <header class="about-page__intro">
          <h1 id="about-page-heading" class="about-page__name font-display">
            James Reilly
          </h1>
          <p class="about-page__place font-display">London</p>
          <h2 class="about-page__role font-display">
            Product designer. Founder, Aced-It.
          </h2>
        </header>

        <div class="about-page__body">
          <p class="about-page__hook">Still curious...</p>
          <p>
            What excites me most about any project is the questions, the what ifs, the exploration
            of ideas with people to arrive at the destination that is both functional and
            aesthetically pleasing to the end user.
          </p>
          <p>
            With AI now everywhere I don&apos;t believe this has changed the approach. Sure it can
            code superbly, design well and get us there faster. But only with proper design
            conversations first. Basically the GIGO (Garbage In, Garbage Out) computing principle
            rings true now for me more than ever.
          </p>
          <p>
            Design and UX got too bloated, and an academia cloud came over the industry, where
            people would focus more on the process than the work itself. If you work in tech you
            know what I mean. This devalued the effect of design on companies by selling process
            over outcomes.
          </p>
          <p>
            I want to be in teams that communicate, work together and build interesting products.
          </p>
          <p>
            <a href={`mailto:${email}`}>{email}</a>
          </p>
        </div>
      </div>

      <figure class="about-page__portrait">
        <img
          src="/images/james-portrait.jpg"
          alt="Portrait of James Reilly"
          width="929"
          height="1024"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </figure>
    </article>

    <Footer thoughts={thoughts} />
  </main>
</BaseLayout>

<style>
  .about-page {
    color: var(--color-text);
    background: var(--color-bg);
  }

  .about-page__shell {
    width: 100%;
    max-width: 62rem;
    margin-inline: auto;
    padding: clamp(6.5rem, 12vh, 8.5rem) clamp(1.25rem, 4vw, 1.5rem) clamp(3rem, 6vh, 5rem);
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 5vw, 3rem);
    align-items: start;
  }

  @media (min-width: 860px) {
    .about-page__shell {
      grid-template-columns: minmax(0, 7fr) minmax(0, 3fr);
      gap: clamp(2rem, 4vw, 3.5rem);
    }
  }

  .about-page__copy {
    min-width: 0;
  }

  .about-page__intro {
    margin-bottom: 1.75rem;
  }

  .about-page__name {
    margin: 0;
    font-size: 2rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--color-heading);
  }

  .about-page__place {
    margin: 0.35rem 0 0;
    font-size: 1.5rem;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: 0;
    color: var(--color-subhead);
  }

  .about-page__role {
    margin: 0.85rem 0 0;
    font-size: 1.5rem;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: 0;
    color: var(--color-subhead);
  }

  .about-page__body {
    display: grid;
    gap: 1rem;
  }

  .about-page__body p {
    margin: 0;
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.65;
    color: var(--color-text);
    text-wrap: pretty;
  }

  .about-page__hook {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.65;
    color: var(--color-text);
  }

  .about-page__body a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 0.18em;
    text-decoration-thickness: 1px;
  }

  .about-page__body a:hover,
  .about-page__body a:focus-visible {
    opacity: 0.75;
  }

  .about-page__portrait {
    margin: 0;
    width: min(100%, 16rem);
    justify-self: start;
  }

  .about-page__portrait img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    object-position: center 18%;
  }

  @media (min-width: 860px) {
    .about-page__portrait {
      width: 100%;
      justify-self: end;
      position: sticky;
      top: 6.25rem;
    }
  }
</style>
