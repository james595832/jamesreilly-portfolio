---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import GlitchPortrait from '../components/GlitchPortrait.astro';
import { getPlaygroundMeta } from '../lib/playground';

const thoughts = (await getPlaygroundMeta()).map((item) => ({
  label: item.client,
  href: `/playground/${item.slug}`,
}));

const email = 'hello@jamesreilly.design';
---

<BaseLayout
  title="About — James Reilly"
  description="James Reilly is an AI product designer with 26 years across print, digital, and AI — currently IC at J.P. Morgan and founder of Aced-It."
>
  <Nav />
  <main id="main" class="about-page">
    <article class="about-page__shell">
      {/* Mobbin-style show stack: portrait → name → short role → body in one centred measure */}
      <figure class="about-page__portrait">
        <GlitchPortrait loading="eager" fetchpriority="high" />
      </figure>

      <header class="about-page__intro">
        <p class="about-page__kicker font-display">About</p>
        <h1 id="about-page-heading" class="about-page__name font-display">
          James Reilly
        </h1>
        <p class="about-page__role font-serif">
          AI product designer · J.P. Morgan IC · Founder, Aced-It
        </p>
      </header>

      <div class="about-page__body">
        <p>
          I am an AI product designer with 26 years of experience working in print, digital, and now
          AI. I merge all three to cope with the pace 2026 has forced on product teams.
        </p>
        <p>
          The process is not magic. Always start with the problem. Why are you delivering this work?
          What value does it bring to the business and the user? Ask questions. Speak to users.
          Build relationships with the people building it. Communication is still the skill that
          decides whether a product ships or dies in a deck.
        </p>
        <p>
          I&apos;ve run my own companies and built startups for others from 0 to 1. Fifteen years
          freelancing across studios and banks. I now work as an IC at J.P. Morgan, embedded as an
          internal consultant on product design for the senior leadership team — moving between
          design, AI, and research.
        </p>
        <p>
          At the bank I sit on the Claude Code forum as the only designer with a license, running
          experiments daily on how AI changes the design process and where it actually creates
          leverage rather than noise. Outside of that I&apos;m building
          <a href="https://acedit.app" target="_blank" rel="noopener noreferrer">Aced-It</a>
          — interview prep for designers who need to walk into high-stakes hiring fully prepared.
        </p>
      </div>

      <p class="about-page__contact">
        Work, briefs, or a conversation:
        <a href={`mailto:${email}`}>{email}</a>
      </p>
    </article>

    <Footer thoughts={thoughts} />
  </main>
</BaseLayout>

<style>
  .about-page {
    color: var(--color-text);
    background:
      radial-gradient(ellipse 60% 45% at 50% 8%, rgba(0, 212, 255, 0.09), transparent 58%),
      radial-gradient(ellipse 40% 30% at 50% 100%, rgba(255, 255, 255, 0.03), transparent 50%),
      var(--color-bg);
  }

  .about-page__shell {
    width: 100%;
    max-width: 40rem;
    margin-inline: auto;
    padding: clamp(6.5rem, 12vh, 8.5rem) clamp(1.25rem, 4vw, 2rem) clamp(3rem, 6vh, 5rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .about-page__portrait {
    margin: 0 0 clamp(1.75rem, 4vw, 2.5rem);
    width: min(100%, 17.5rem);
    display: flex;
    justify-content: center;
  }

  .about-page__portrait :global(.glitch-portrait) {
    width: 100%;
    max-width: none;
  }

  .about-page__intro {
    width: 100%;
    margin-bottom: clamp(1.75rem, 4vw, 2.25rem);
  }

  .about-page__kicker {
    margin: 0 0 0.85rem;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .about-page__name {
    margin: 0;
    font-size: clamp(2.5rem, 6.5vw, 4rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.035em;
    text-transform: uppercase;
  }

  .about-page__role {
    margin: 1rem 0 0;
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    font-style: italic;
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.72);
  }

  .about-page__body {
    width: 100%;
    max-width: 34rem;
    display: grid;
    gap: 1.2rem;
  }

  .about-page__body p {
    margin: 0;
    font-size: clamp(1rem, 1.2vw, 1.1rem);
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.84);
    text-wrap: pretty;
  }

  .about-page__body a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 0.18em;
    text-decoration-thickness: 1px;
  }

  .about-page__body a:hover,
  .about-page__body a:focus-visible {
    color: #fff;
  }

  .about-page__contact {
    width: 100%;
    max-width: 34rem;
    margin: 2rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    font-size: 0.975rem;
    line-height: 1.5;
    color: var(--color-muted);
  }

  .about-page__contact a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .about-page__contact a:hover,
  .about-page__contact a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
</style>
