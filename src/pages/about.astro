---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PlaygroundFeed from '../components/PlaygroundFeed.astro';
import CaseStudyPanels from '../components/CaseStudyPanels.astro';
import CaseStudyOverlay from '../components/CaseStudyOverlay.astro';
import { getPlaygroundMeta } from '../lib/playground';

const items = await getPlaygroundMeta();
const thoughts = items.map((item) => ({
  label: item.client,
  href: `/playground/${item.slug}`,
}));
---

<BaseLayout
  title="About — James Reilly"
  description="About James Reilly and a playground of AI experiments, notes, and work-in-progress."
>
  <Nav />
  <main id="main" class="about-page">
    <section
      class="about-layout mx-auto w-full max-w-[1920px] px-6 pt-28 pb-20 md:px-10 lg:px-16 lg:pt-32"
      aria-label="About and playground"
    >
      <aside class="about-rail about-rail--intro">
        <p class="font-display text-sm font-bold tracking-wide text-text">James Reilly</p>
        <h1
          class="font-display mt-8 text-[clamp(2.25rem,4vw,3.25rem)] font-bold uppercase leading-[0.9] tracking-[-0.02em] text-text"
        >
          AI Product<br />Designer
        </h1>
        <p
          class="case-study-lede mt-8 max-w-sm text-base leading-relaxed text-text/80"
        >
          A place for experiments, notes, and the work that does not fit a client case study.
          Scroll the feed, open anything that looks interesting.
        </p>
        <div class="mt-10 space-y-2 text-sm tracking-wide text-muted">
          <p>
            <a class="transition-colors hover:text-accent" href="mailto:hireme@jamesreilly.design"
              >hireme@jamesreilly.design</a
            >
          </p>
          <p>
            <a class="transition-colors hover:text-accent" href="/#work">Case studies</a>
          </p>
        </div>
      </aside>

      <div class="about-feed min-w-0">
        <div class="mb-8 flex items-end justify-between gap-4 lg:mb-10">
          <h2 class="font-display text-xs font-bold uppercase tracking-[0.16em] text-muted">
            Playground
          </h2>
          <p class="text-xs tracking-wide text-muted">{items.length} entries</p>
        </div>
        {
          items.length > 0 ? (
            <PlaygroundFeed items={items} />
          ) : (
            <p class="text-muted font-serif">
              Nothing here yet — add an MDX file under <code>src/content/playground/</code>.
            </p>
          )
        }
      </div>

      <aside class="about-rail about-rail--index">
        <p class="font-display text-xs font-bold uppercase tracking-[0.16em] text-muted">Index</p>
        <ul class="mt-6 space-y-3">
          {
            items.map((item) => (
              <li>
                <a
                  href={`/playground/${item.slug}`}
                  data-case-slug={item.slug}
                  class="case-card-trigger group flex flex-col gap-0.5 text-left transition-colors hover:text-accent"
                >
                  <span class="font-display text-sm font-bold tracking-wide text-text group-hover:text-accent">
                    {item.client}
                  </span>
                  <span class="text-xs tracking-wide text-muted">{item.year}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </aside>
    </section>

    <Footer thoughts={thoughts} />
  </main>

  <CaseStudyPanels collection="playground" />
  <CaseStudyOverlay
    caseStudies={items}
    pathPrefix="/playground"
    closePath="/about"
  />
</BaseLayout>

<style is:global>
  /* Single document scroll — sticky side columns were fighting the wheel. */
  .about-page {
    scroll-behavior: auto;
  }

  .about-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  @media (min-width: 1024px) {
    .about-layout {
      grid-template-columns: minmax(220px, 280px) minmax(0, 1fr) minmax(180px, 240px);
      gap: 2.5rem;
      align-items: start;
    }
  }
</style>
