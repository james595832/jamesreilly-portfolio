---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PlaygroundFeed from '../components/PlaygroundFeed.astro';
import CaseStudyPanels from '../components/CaseStudyPanels.astro';
import CaseStudyOverlay from '../components/CaseStudyOverlay.astro';
import { getPlaygroundMeta } from '../lib/playground';

const items = await getPlaygroundMeta();
const thoughts = items.map((item) => ({
  label: item.client,
  href: `/playground/${item.slug}`,
}));
---

<BaseLayout
  title="Ideas — James Reilly"
  description="Ideas, AI experiments, notes, and work-in-progress from James Reilly."
>
  <Nav />
  <main id="main" class="ideas-page">
    <section class="ideas-shell" aria-label="Ideas">
      <header class="ideas-intro">
        <p class="ideas-intro__kicker font-display">Ideas</p>
        <h1 id="ideas-heading" class="ideas-intro__title font-display">Ideas</h1>
        <p class="case-study-lede ideas-intro__lede">
          Experiments, notes, and work that does not fit a client case study.
        </p>
      </header>

      <nav class="ideas-index" aria-label="Ideas index">
        {
          items.map((item) => (
            <a
              href={`/playground/${item.slug}`}
              data-case-slug={item.slug}
              class="case-card-trigger ideas-index__link"
            >
              {item.client}
            </a>
          ))
        }
      </nav>

      <div class="ideas-feed">
        {
          items.length > 0 ? (
            <PlaygroundFeed items={items} />
          ) : (
            <p class="text-muted font-serif text-center">
              Nothing here yet — add an MDX file under <code>src/content/playground/</code>.
            </p>
          )
        }
      </div>
    </section>

    <Footer thoughts={thoughts} />
  </main>

  <CaseStudyPanels collection="playground" />
  <CaseStudyOverlay
    caseStudies={items}
    pathPrefix="/playground"
    closePath="/ideas"
  />
</BaseLayout>

<style is:global>
  .ideas-page {
    scroll-behavior: auto;
    background:
      radial-gradient(ellipse 55% 40% at 50% 0%, rgba(0, 212, 255, 0.07), transparent 55%),
      #000;
  }

  .ideas-shell {
    width: 100%;
    max-width: 44rem;
    margin-inline: auto;
    padding: clamp(6.5rem, 12vh, 8.5rem) clamp(1.25rem, 4vw, 2rem) clamp(3rem, 6vh, 5rem);
  }

  .ideas-intro {
    text-align: center;
    margin-bottom: clamp(2rem, 4vw, 2.75rem);
  }

  .ideas-intro__kicker {
    margin: 0;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .ideas-intro__title {
    margin: 1rem 0 0;
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 0.95;
    text-transform: uppercase;
    color: var(--color-text);
  }

  .ideas-intro__lede {
    margin: 1.15rem auto 0;
    max-width: 28rem;
    font-size: 1.05rem;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.78);
    white-space: normal;
  }

  .ideas-index {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.25rem;
    margin-bottom: clamp(2.75rem, 6vh, 4rem);
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .ideas-index__link {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .ideas-index__link:hover,
  .ideas-index__link:focus-visible {
    color: var(--color-accent);
  }

  .ideas-feed {
    width: 100%;
  }
</style>
