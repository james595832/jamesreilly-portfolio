---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PlaygroundFeed from '../components/PlaygroundFeed.astro';
import CaseStudyPanels from '../components/CaseStudyPanels.astro';
import CaseStudyOverlay from '../components/CaseStudyOverlay.astro';
import { getPlaygroundMeta } from '../lib/playground';

const items = await getPlaygroundMeta();
const thoughts = items.map((item) => ({
  label: item.client,
  href: `/playground/${item.slug}`,
}));
---

<BaseLayout
  title="Ideas — James Reilly"
  description="Ideas, AI experiments, notes, and work-in-progress from James Reilly."
>
  <Nav />
  <main id="main" class="ideas-page">
    <section
      class="ideas-shell mx-auto w-full max-w-[1920px] px-6 pt-28 pb-20 md:px-10 lg:px-16 lg:pt-32"
      aria-label="Ideas"
    >
      <header class="ideas-intro">
        <p class="font-display text-xs font-bold uppercase tracking-[0.16em] text-muted">Ideas</p>
        <h1
          id="ideas-heading"
          class="font-display mt-6 text-[clamp(2.5rem,6vw,4.5rem)] font-bold uppercase leading-[0.9] tracking-[-0.03em] text-text"
        >
          Ideas
        </h1>
        <p class="case-study-lede ideas-intro__lede mt-5 text-base leading-relaxed text-text/80 md:text-lg">
          Experiments, notes, and work that does not fit a client case study.
        </p>
      </header>

      <div class="ideas-layout">
        <div class="ideas-feed min-w-0">
          <div class="mb-8 flex items-end justify-between gap-4 lg:mb-10">
            <h2 class="font-display text-xs font-bold uppercase tracking-[0.16em] text-muted">
              Feed
            </h2>
            <p class="text-xs tracking-wide text-muted">{items.length} entries</p>
          </div>
          {
            items.length > 0 ? (
              <PlaygroundFeed items={items} />
            ) : (
              <p class="text-muted font-serif">
                Nothing here yet — add an MDX file under <code>src/content/playground/</code>.
              </p>
            )
          }
        </div>

        <aside class="ideas-rail ideas-rail--index">
          <p class="font-display text-xs font-bold uppercase tracking-[0.16em] text-muted">Index</p>
          <ul class="mt-6 space-y-3">
            {
              items.map((item) => (
                <li>
                  <a
                    href={`/playground/${item.slug}`}
                    data-case-slug={item.slug}
                    class="case-card-trigger group flex flex-col gap-0.5 text-left transition-colors hover:text-accent"
                  >
                    <span class="font-display text-sm font-bold tracking-wide text-text group-hover:text-accent">
                      {item.client}
                    </span>
                    <span class="text-xs tracking-wide text-muted">{item.year}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </aside>
      </div>
    </section>

    <Footer thoughts={thoughts} />
  </main>

  <CaseStudyPanels collection="playground" />
  <CaseStudyOverlay
    caseStudies={items}
    pathPrefix="/playground"
    closePath="/ideas"
  />
</BaseLayout>

<style is:global>
  .ideas-page {
    scroll-behavior: auto;
  }

  .ideas-intro {
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }

  .ideas-intro__lede {
    max-width: none;
    white-space: nowrap;
  }

  @media (max-width: 720px) {
    .ideas-intro__lede {
      white-space: normal;
    }
  }

  .ideas-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  @media (min-width: 1024px) {
    .ideas-layout {
      grid-template-columns: minmax(0, 1fr) minmax(180px, 240px);
      gap: 2.5rem;
      align-items: start;
    }
  }
</style>
