---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import IdeasDirectory from '../components/IdeasDirectory.astro';
import CaseStudyPanels from '../components/CaseStudyPanels.astro';
import CaseStudyOverlay from '../components/CaseStudyOverlay.astro';
import { getPlaygroundMeta } from '../lib/playground';

const items = await getPlaygroundMeta();
const thoughts = items.map((item) => ({
  label: item.client,
  href: `/playground/${item.slug}`,
}));
---

<BaseLayout
  title="Ideas — James Reilly"
  description="Ideas, AI experiments, notes, and work-in-progress from James Reilly."
>
  <Nav />
  <main id="main" class="ideas-page">
    <IdeasDirectory items={items} />
    <Footer thoughts={thoughts} />
  </main>

  <CaseStudyPanels collection="playground" />
  <CaseStudyOverlay
    caseStudies={items}
    pathPrefix="/playground"
    closePath="/ideas"
  />
</BaseLayout>

<style is:global>
  .ideas-page {
    scroll-behavior: auto;
    background: var(--color-bg);
    color: var(--color-text);
  }
</style>
