---
import { ClientRouter, fade } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "James Reilly, AI Product Designer",
  description = "Portfolio of James Reilly, AI Product Designer. Case studies across finance, travel, and healthcare.",
} = Astro.props;
---

<!doctype html>
<html lang="en" transition:animate={fade({ duration: '280ms' })}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Serif:ital,wght@0,400;1,400&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="min-h-screen bg-bg text-text">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded focus:bg-accent focus:px-4 focus:py-2 focus:text-bg focus:outline-none"
    >
      Skip to main content
    </a>
    <slot />
    <script>
      function scrollToHashIfNeeded() {
        const { hash } = window.location;
        if (!hash || hash === '#') return;

        const id = decodeURIComponent(hash.slice(1));
        const target =
          document.getElementById(id) ||
          document.querySelector<HTMLElement>(`[name="${CSS.escape(id)}"]`);
        if (!target) return;

        // Wait one frame so swap layout is settled (especially after ClientRouter).
        requestAnimationFrame(() => {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      }

      document.addEventListener('astro:page-load', scrollToHashIfNeeded);
    </script>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
