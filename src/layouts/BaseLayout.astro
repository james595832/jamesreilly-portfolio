---
import { ClientRouter, fade } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "James Reilly — Product designer",
  description = "Product designer. Founder of Aced-It.",
} = Astro.props;
---

<!doctype html>
<html lang="en" transition:animate={fade({ duration: '280ms' })}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <title>{title}</title>
    <script is:inline>
      if (location.hash === '#work') {
        history.replaceState(null, '', location.pathname + location.search);
      }
    </script>
    <ClientRouter />
  </head>
  <body class="min-h-screen bg-bg text-text">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded focus:bg-accent focus:px-4 focus:py-2 focus:text-bg focus:outline-none"
    >
      Skip to main content
    </a>
    <slot />
    <script>
      function scrollToHashIfNeeded() {
        const { hash, pathname } = window.location;
        // /#work used to be the Work link. It opened the homepage already
        // scrolled past the intro. Land at the top and drop the hash.
        if (hash === '#work') {
          history.replaceState(null, '', pathname || '/');
          window.scrollTo({ top: 0, behavior: 'auto' });
          return;
        }
        if (!hash || hash === '#') return;

        const id = decodeURIComponent(hash.slice(1));
        const target =
          document.getElementById(id) ||
          document.querySelector<HTMLElement>(`[name="${CSS.escape(id)}"]`);
        if (!target) return;

        // Instant on load. A smooth scroll from the top reads as the page opening halfway down.
        requestAnimationFrame(() => {
          target.scrollIntoView({ behavior: 'auto', block: 'start' });
        });
      }

      document.addEventListener('astro:page-load', scrollToHashIfNeeded);
    </script>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
