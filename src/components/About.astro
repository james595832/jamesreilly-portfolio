---
const email = 'hello@jamesreilly.design';
---

<section id="about" class="home-about" aria-labelledby="about-heading">
  <h2 id="about-heading" class="home-about__heading font-display">About</h2>
  <div class="home-about__copy">
    <p>
      Lots of irons in the fire. Bank work. Own products. Side experiments. I stay in the tools
      and keep moving forward.
    </p>
    <p>
      IC at J.P. Morgan.
      <a href="https://acedit.app" target="_blank" rel="noopener noreferrer">Aced-It</a>.
      <a href="/playground/first">First.</a>
      <a href="/ideas">Ideas</a>.
    </p>
    <p>
      <a href={`mailto:${email}`}>{email}</a>
    </p>
  </div>
</section>

<style>
  .home-about {
    width: 100%;
    max-width: none;
    margin-inline: 0;
    padding-inline: 0;
    padding-bottom: 4.5rem;
  }

  .home-about__heading {
    margin: 0 0 1.1rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .home-about__copy {
    display: grid;
    gap: 1rem;
  }

  .home-about__copy p {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--color-text);
  }

  .home-about__copy a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 0.16em;
    text-decoration-thickness: 1px;
  }

  .home-about__copy a:hover,
  .home-about__copy a:focus-visible {
    opacity: 0.75;
  }
</style>
