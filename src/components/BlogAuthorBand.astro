---
interface Props {
  portraitSrc?: string;
  portraitSrc2x?: string;
}

const {
  portraitSrc = '/images/author-portrait.png',
  portraitSrc2x = '/images/author-portrait@2x.png',
} = Astro.props;

const email = 'hello@jamesreilly.design';
---

<aside class="blog-author-band" aria-label="About the author">
  <div class="blog-author-band__inner">
    <div class="blog-author-band__copy">
      <h2 class="blog-author-band__title font-display">Hi I&apos;m James.</h2>
      <p class="blog-author-band__bio">
        I write the notes on this site. IC at J.P. Morgan. Founder of Aced-It.
      </p>
      <a class="blog-author-band__email" href={`mailto:${email}`}>
        {email}
      </a>
    </div>

    <div class="blog-author-band__portrait" aria-hidden="true">
      <img
        src={portraitSrc}
        srcset={`${portraitSrc} 1x, ${portraitSrc2x} 2x`}
        alt=""
        width="480"
        height="480"
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>
</aside>

<style>
  .blog-author-band {
    background: var(--color-surface);
    color: var(--color-text);
    width: 100%;
    padding: 2.75rem 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--color-text) 10%, transparent);
  }

  @media (min-width: 768px) {
    .blog-author-band {
      padding: 3.25rem 2.5rem;
    }
  }

  .blog-author-band__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2.25rem;
    width: 100%;
    max-width: 960px;
    margin-inline: auto;
  }

  @media (min-width: 720px) {
    .blog-author-band__inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 3rem;
    }
  }

  .blog-author-band__copy {
    min-width: 0;
    flex: 1 1 auto;
  }

  .blog-author-band__title {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.3;
    color: var(--color-subhead);
  }

  .blog-author-band__bio {
    margin: 1rem 0 0;
    max-width: 28rem;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--color-muted);
  }

  .blog-author-band__email {
    display: inline-block;
    margin-top: 1.25rem;
    color: var(--color-accent);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.4;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .blog-author-band__email:hover,
  .blog-author-band__email:focus-visible {
    opacity: 0.75;
  }

  .blog-author-band__portrait {
    flex: 0 0 auto;
    width: clamp(9rem, 22vw, 13rem);
    height: clamp(9rem, 22vw, 13rem);
    overflow: hidden;
    background: #000;
  }

  .blog-author-band__portrait img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 12%;
    transform: scale(1.04);
    transform-origin: center 15%;
  }

  .case-study-scroll-panel[data-theme-light='true'] .blog-author-band,
  .case-study-scroll-panel[data-theme-light='true'] .blog-author-band__title {
    color: var(--color-text) !important;
  }

  .case-study-scroll-panel[data-theme-light='true'] .blog-author-band__bio {
    color: var(--color-muted) !important;
  }

  .case-study-scroll-panel[data-theme-light='true'] .blog-author-band__email {
    color: var(--color-accent) !important;
  }

  .case-study-scroll-panel[data-theme-light='true'] .blog-author-band__portrait {
    background: #000 !important;
  }
</style>
