---
import type { CaseStudyMeta } from '../types/caseStudy';
import { getCardTileColor } from '../lib/cardColor';

interface Props {
  items: CaseStudyMeta[];
}

const { items } = Astro.props;
---

<div data-case-feed class="playground-feed">
  {
    items.map((item, index) => {
      const tileColor = getCardTileColor(item);
      const hasImage = Boolean(item.cardImage || item.heroImage);
      const imageSrc = item.cardImage || item.heroImage;
      const number = String(index + 1).padStart(2, '0');

      return (
        <article class="playground-tile">
          <a
            href={`/playground/${item.slug}`}
            data-case-slug={item.slug}
            class="case-card-trigger playground-tile__link group"
            aria-label={`Open: ${item.client}`}
          >
            <span class="playground-tile__number font-display" aria-hidden="true">
              {number}
            </span>

            <div
              class="playground-tile__media"
              style={{ backgroundColor: tileColor }}
            >
              {
                hasImage && imageSrc ? (
                  <img
                    src={imageSrc}
                    alt=""
                    class="playground-tile__img"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <div class="playground-tile__placeholder" aria-hidden="true" />
                )
              }
            </div>

            <div class="playground-tile__body">
              <h2 class="playground-tile__title font-display">{item.client}</h2>
              <p class="playground-tile__summary">{item.summary}</p>
              {item.year ? <p class="playground-tile__meta">{item.year}</p> : null}
            </div>
          </a>
        </article>
      );
    })
  }
</div>

<style>
  .playground-feed {
    display: flex;
    flex-direction: column;
    gap: clamp(3.5rem, 8vh, 5.5rem);
    align-items: center;
  }

  .playground-tile {
    width: 100%;
    max-width: 34rem;
  }

  .playground-tile__link {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    text-decoration: none;
    color: inherit;
    outline: none;
  }

  .playground-tile__link:focus-visible {
    outline: 2px solid var(--color-accent, #00d4ff);
    outline-offset: 6px;
  }

  .playground-tile__number {
    display: block;
    margin-bottom: 0.85rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: rgba(255, 255, 255, 0.45);
    line-height: 1;
  }

  .playground-tile__link:hover .playground-tile__number,
  .playground-tile__link:focus-visible .playground-tile__number {
    color: var(--color-accent, #00d4ff);
  }

  .playground-tile__media {
    position: relative;
    overflow: hidden;
    width: min(100%, 28rem);
    margin-inline: auto;
    aspect-ratio: 16 / 10;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: var(--color-surface, #1a1a1a);
  }

  .playground-tile__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(1.01);
    transition: transform 0.55s ease;
  }

  .playground-tile__placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(145deg, #1a1a1a 0%, #0a0a0a 100%);
  }

  .playground-tile__link:hover .playground-tile__img,
  .playground-tile__link:focus-visible .playground-tile__img {
    transform: scale(1.035);
  }

  .playground-tile__body {
    margin-top: 1.35rem;
    max-width: 28rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .playground-tile__title {
    margin: 0;
    font-size: clamp(1.35rem, 1.1rem + 0.9vw, 1.85rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.15;
    text-transform: uppercase;
    color: #fff;
    transition: color 0.2s ease;
  }

  .playground-tile__link:hover .playground-tile__title,
  .playground-tile__link:focus-visible .playground-tile__title {
    color: var(--color-accent, #00d4ff);
  }

  .playground-tile__summary {
    margin: 0.65rem 0 0;
    font-size: 0.975rem;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.68);
    text-wrap: pretty;
  }

  .playground-tile__meta {
    margin: 0.75rem 0 0;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.4);
  }

  @media (prefers-reduced-motion: reduce) {
    .playground-tile__img {
      transition: none;
    }
  }
</style>
