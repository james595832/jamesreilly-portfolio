---
interface Props {
  title: string;
  company: string;
  role: string;
  year: string;
  color?: string;
}

const { title, company, role, year, color = '#00D4FF' } = Astro.props;
---

<header class="relative mb-16 overflow-hidden rounded-sm bg-surface px-6 py-20 md:px-12 md:py-28">
  <div
    class="pointer-events-none absolute inset-0 opacity-20"
    style={`background: radial-gradient(circle at 30% 50%, ${color}, transparent 70%)`}
  />
  <div class="relative mx-auto max-w-4xl">
    <p class="font-serif text-accent">{company}</p>
    <h1 class="case-study-section-title mt-4 text-4xl md:text-[2.75rem]">{title}</h1>
    <div class="case-study-meta mt-8 flex flex-wrap gap-4 text-sm text-muted">
      <span>{role}</span>
      <span aria-hidden="true">·</span>
      <span>{year}</span>
    </div>
  </div>
</header>
