---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`case-study-copy mx-auto max-w-3xl px-6 md:px-0 ${className}`}>
  <div class="font-serif text-2xl leading-relaxed md:text-3xl" style="font-family: var(--font-serif)">
    <slot />
  </div>
</div>
