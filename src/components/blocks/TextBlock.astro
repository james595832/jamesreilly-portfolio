---
interface Props {
  title?: string;
  class?: string;
}

const { title, class: className = '' } = Astro.props;
---

<section class={`mx-auto max-w-3xl px-6 py-6 md:px-0 md:py-8 ${className}`}>
  {title && (
    <h2 class="case-study-section-title text-text mb-4 md:mb-5">
      {title}
    </h2>
  )}
  <div class="case-study-copy prose-case space-y-4 text-base leading-relaxed md:text-lg text-pretty">
    <slot />
  </div>
</section>

<style>
  .prose-case :global(p) {
    margin-bottom: 1rem;
    text-wrap: pretty;
    orphans: 3;
    widows: 3;
  }
  .prose-case :global(strong) {
    color: inherit;
    font-weight: 700;
  }
  .prose-case :global(a.case-inline-link),
  .prose-case :global(.case-inline-link) {
    color: var(--color-accent, #00d4ff);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
    transition: color 0.2s ease, text-decoration-color 0.2s ease;
  }
  .prose-case :global(a.case-inline-link:hover),
  .prose-case :global(.case-inline-link:hover) {
    color: inherit;
    text-decoration-color: currentColor;
  }
</style>
