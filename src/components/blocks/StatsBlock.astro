---
interface Props {
  items: string[];
}

const { items } = Astro.props;
---

<div class="mx-auto flex max-w-3xl flex-wrap gap-3 px-6 py-8 md:px-0">
  {
    items.map((item) => (
      <span class="rounded-full border border-text/15 bg-text/5 px-4 py-2 text-sm text-muted">
        {item}
      </span>
    ))
  }
</div>
