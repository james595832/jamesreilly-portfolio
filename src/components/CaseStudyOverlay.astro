---
import CaseStudyLandingHeader from './CaseStudyLandingHeader.astro';
import Footer from './Footer.astro';
import type { CaseStudyMeta } from '../types/caseStudy';

interface Props {
  caseStudies: CaseStudyMeta[];
  initialSlug?: string;
  /** History path prefix when opening an entry, e.g. `/work` or `/playground`. */
  pathPrefix?: string;
  /** Path to restore on close when the overlay owns the URL. */
  closePath?: string;
  moreLabel?: string;
}

const {
  caseStudies,
  initialSlug,
  pathPrefix = '/work',
  closePath = '/',
  moreLabel = 'More work',
} = Astro.props;

const showAuthorBand = pathPrefix === '/playground';
const ideaLinks = showAuthorBand
  ? caseStudies.map((study) => ({
      label: study.client,
      href: `/playground/${study.slug}`,
    }))
  : [];

const SHEET_TOP_GAP = 48;
const SHEET_RADIUS = 24;
const SHEET_INSET = 20;
const BACKDROP_OPACITY_SHEET = 0.28;
---

<div
  id="case-study-overlay"
  class="fixed inset-0 z-[60]"
  role="dialog"
  aria-modal="true"
  aria-label="Case study"
  hidden={!initialSlug}
  data-case-studies={JSON.stringify(caseStudies)}
  data-initial-slug={initialSlug ?? ''}
  data-path-prefix={pathPrefix}
  data-close-path={closePath}
  data-show-author-band={showAuthorBand ? 'true' : 'false'}
>
  <button
    type="button"
    data-overlay-backdrop
    class="absolute inset-0 bg-text/40 will-change-[opacity]"
    style={`opacity: ${BACKDROP_OPACITY_SHEET}`}
    aria-label="Close case study"
  ></button>

  <div
    data-overlay-sheet
    class="case-study-sheet fixed z-[72] flex flex-col overflow-hidden border border-text/10 bg-bg shadow-[0_-12px_48px_rgba(26,26,26,0.16)] will-change-[transform]"
    style={{
      top: `${SHEET_TOP_GAP}px`,
      left: `${SHEET_INSET}px`,
      right: `${SHEET_INSET}px`,
      height: `calc(100dvh - ${SHEET_TOP_GAP}px)`,
      borderTopLeftRadius: `${SHEET_RADIUS}px`,
      borderTopRightRadius: `${SHEET_RADIUS}px`,
    }}
  >
    <div data-overlay-motion class="flex min-h-0 flex-1 flex-col will-change-[transform,opacity]">
      <div class="flex shrink-0 items-center justify-end px-5 pt-5 pb-2 md:px-8 md:pt-6">
        <button
          type="button"
          data-overlay-close
          class="case-study-close-btn flex h-10 w-10 items-center justify-center rounded-full transition-colors"
          aria-label="Close case study"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M18 6L6 18M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <div
        data-overlay-scroll
        class="case-study-scroll-panel relative min-h-0 flex-1 overflow-y-auto overscroll-contain"
      >
        <div data-overlay-header-slot></div>

        <div
          data-overlay-content
          class="case-study-body mx-auto w-full max-w-[1400px] px-6 pb-10 md:px-10 lg:px-16 [&_.case-study-panel]:max-w-none [&_.case-study-panel>header]:hidden [&_.case-study-panel_section]:mx-auto [&_.case-study-panel_.workflow-diagram]:max-w-5xl"
        ></div>

        {
          showAuthorBand && (
            <div data-overlay-author class="w-full">
              <Footer thoughts={ideaLinks} headingId="idea-contact-heading" />
            </div>
          )
        }

        {
          !showAuthorBand && (
            <footer class="case-study-footer">
              <p class="case-study-footer-label font-display">{moreLabel}</p>
              <div class="case-more">
                <div class="case-more__head font-display" aria-hidden="true">
                  <span>Name</span>
                  <span class="case-more__head-year">Year</span>
                  <span />
                </div>
                <ul data-overlay-more class="case-more__list">
                  {caseStudies.map((study) => {
                    const panelId = `more-panel-${study.slug}`;
                    const shot = study.cardImage || study.heroImage;
                    return (
                      <li class="case-more__row" data-more-slug={study.slug} data-more-row>
                        <button
                          type="button"
                          class="case-more__bar"
                          data-more-toggle
                          aria-expanded="false"
                          aria-controls={panelId}
                        >
                          <span class="case-more__name font-display">{study.client}</span>
                          <span class="case-more__year">{study.year}</span>
                          <span class="case-more__mark" aria-hidden="true" />
                        </button>
                        <div class="case-more__panel" id={panelId} data-more-panel hidden>
                          <div class="case-more__clip">
                          <div class="case-more__panel-inner">
                            {shot && (
                              <div class="case-more__shots">
                                <figure class="case-more__shot">
                                  <img
                                    src={shot}
                                    alt={`${study.client} — ${study.title}`}
                                    loading="lazy"
                                    decoding="async"
                                  />
                                </figure>
                              </div>
                            )}
                            <div class="case-more__copy">
                              <p>{study.summary}</p>
                              <a
                                class="case-more__read case-card-trigger font-display"
                                href={`${pathPrefix}/${study.slug}`}
                                data-case-slug={study.slug}
                              >
                                <span>Case study</span>
                                <span aria-hidden="true">→</span>
                              </a>
                            </div>
                          </div>
                          </div>
                        </div>
                      </li>
                    );
                  })}
                </ul>
              </div>
            </footer>
          )
        }
      </div>
    </div>
  </div>
</div>

<div hidden aria-hidden="true">
  {
    caseStudies.map((study) => (
      <div data-header-for={study.slug}>
        <CaseStudyLandingHeader study={study} />
      </div>
    ))
  }
</div>

<script>
  import { initCaseStudyOverlay } from '../scripts/case-study-overlay.ts';

  function readOverlayConfig() {
    const overlay = document.getElementById('case-study-overlay');
    if (!overlay) return null;

    let caseStudies = [];
    try {
      caseStudies = JSON.parse(overlay.dataset.caseStudies ?? '[]');
    } catch {
      caseStudies = [];
    }

    const initialSlug = overlay.dataset.initialSlug || undefined;
    const pathPrefix = overlay.dataset.pathPrefix || '/work';
    const closePath = overlay.dataset.closePath || '/';
    const showAuthorBand = overlay.dataset.showAuthorBand === 'true';
    return { caseStudies, initialSlug, pathPrefix, closePath, showAuthorBand };
  }

  function morePanel(row: HTMLElement) {
    return row.querySelector<HTMLElement>('[data-more-panel]');
  }

  function releaseMorePanel(panel: HTMLElement) {
    const wasHidden = panel.hidden;
    panel.hidden = false;
    if (wasHidden) panel.getBoundingClientRect();
  }

  function setMoreOpen(row: HTMLElement, open: boolean) {
    const toggle = row.querySelector<HTMLButtonElement>('[data-more-toggle]');
    const panel = morePanel(row);
    if (open && panel) releaseMorePanel(panel);
    row.classList.toggle('is-open', open);
    toggle?.setAttribute('aria-expanded', open ? 'true' : 'false');
    if (!panel) return;
    panel.inert = !open;
    panel.setAttribute('aria-hidden', open ? 'false' : 'true');
  }

  function bootMoreWork() {
    document.querySelectorAll<HTMLElement>('[data-more-row]').forEach((row) => {
      const toggle = row.querySelector<HTMLButtonElement>('[data-more-toggle]');
      const panel = morePanel(row);
      if (panel && !row.classList.contains('is-open')) {
        releaseMorePanel(panel);
        panel.inert = true;
        panel.setAttribute('aria-hidden', 'true');
      }
      if (!toggle || toggle.dataset.bound === 'true') return;
      toggle.dataset.bound = 'true';

      toggle.addEventListener('click', () => {
        const willOpen = !row.classList.contains('is-open');
        document.querySelectorAll<HTMLElement>('[data-more-row].is-open').forEach((openRow) => {
          if (openRow !== row) setMoreOpen(openRow, false);
        });
        setMoreOpen(row, willOpen);
      });
    });
  }

  function boot() {
    const config = readOverlayConfig();
    if (!config) return;
    initCaseStudyOverlay(config);
    bootMoreWork();
  }

  document.addEventListener('astro:page-load', boot);
  document.addEventListener('astro:before-swap', () => {
    window.__caseStudyOverlayCleanup?.();
    window.__caseStudyOverlayCleanup = null;
  });
</script>

<style is:global>
  /*
   * Phone first paint: edge-to-edge page before JS boots.
   * Desktop keeps the parked sheet inset from the Astro inline styles.
   */
  @media (max-width: 767px) {
    #case-study-overlay [data-overlay-sheet] {
      top: 0 !important;
      left: 0 !important;
      right: 0 !important;
      height: 100dvh !important;
      border-radius: 0 !important;
      box-shadow: none !important;
    }

    #case-study-overlay[data-overlay-mode='page'] [data-overlay-backdrop] {
      pointer-events: none;
    }
  }

  .case-study-footer {
    border-top: 1px solid color-mix(in srgb, var(--color-text) 18%, transparent);
    padding-top: 2.5rem;
    padding-bottom: 3rem;
  }

  .case-study-footer-label,
  .case-more__head,
  .case-more__bar,
  .case-more__panel-inner {
    padding-inline: clamp(1.25rem, 4vw, 2.75rem);
  }

  .case-study-footer-label {
    margin: 0 0 1.25rem;
    font-size: 1.5rem;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    line-height: 1.3;
    color: var(--color-subhead);
  }

  .case-more__head,
  .case-more__bar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 4.5rem 1.25rem;
    column-gap: 1.5rem;
    align-items: baseline;
  }

  .case-more__head {
    padding-bottom: 0.45rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-text) 18%, transparent);
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--color-muted);
  }

  .case-more__head-year,
  .case-more__year {
    text-align: right;
  }

  .case-more__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .case-more__row {
    border-bottom: 1px solid color-mix(in srgb, var(--color-text) 18%, transparent);
  }

  .case-more__bar {
    width: 100%;
    margin: 0;
    padding-block: 0.85rem;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: background-color 0.16s ease, color 0.16s ease;
  }

  .case-more__name {
    font-size: 1rem;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.4;
  }

  .case-more__year {
    font-size: 1rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-muted);
  }

  .case-more__mark {
    justify-self: end;
    font-family: var(--font-display);
    font-size: 1.15rem;
    line-height: 1;
  }

  .case-more__mark::before {
    content: '+';
  }

  .case-more__row:hover .case-more__bar,
  .case-more__row:focus-within .case-more__bar,
  .case-more__row.is-open .case-more__bar {
    background: var(--color-text);
    color: var(--color-bg);
  }

  .case-more__row:hover .case-more__year,
  .case-more__row:focus-within .case-more__year,
  .case-more__row.is-open .case-more__year {
    color: color-mix(in srgb, var(--color-bg) 72%, transparent);
  }

  .case-more__row.is-open .case-more__mark::before {
    content: '×';
  }

  .case-more__bar:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
  }

  .case-more__panel {
    display: grid;
    grid-template-rows: 0fr;
    background: var(--color-text);
    color: var(--color-bg);
    transition: grid-template-rows 0.42s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .case-more__row.is-open .case-more__panel {
    grid-template-rows: 1fr;
  }

  .case-more__clip {
    min-height: 0;
    overflow: hidden;
  }

  .case-more__panel-inner {
    display: grid;
    gap: 1.75rem;
    padding-block: 1.5rem 2rem;
  }

  @media (min-width: 860px) {
    .case-more__panel-inner {
      grid-template-columns: minmax(0, 1fr) minmax(14rem, 18rem);
      align-items: start;
      gap: 2.5rem;
    }
  }

  .case-more__shots {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 1rem 1.25rem;
  }

  .case-more__shots::after {
    content: "";
  }

  .case-more__shot {
    margin: 0;
    min-width: 0;
  }

  .case-more__shot img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: center;
    background: #111;
  }

  .case-more__copy p {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.45;
    letter-spacing: -0.01em;
  }

  .case-more__read {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 1.25rem;
    padding: 0.7rem 0.8rem;
    border: 1px solid color-mix(in srgb, var(--color-bg) 35%, transparent);
    color: var(--color-bg);
    font-size: 1rem;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    text-decoration: none;
  }

  .case-more__read:hover,
  .case-more__read:focus-visible {
    background: var(--color-bg);
    color: var(--color-text);
  }

  @media (prefers-reduced-motion: reduce) {
    .case-more__bar,
    .case-more__panel {
      transition: none;
    }
  }
</style>
