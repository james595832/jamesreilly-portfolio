---
interface Props {
  src?: string;
  alt?: string;
}

const {
  src = '/images/me.png',
  alt = 'Portrait of James Reilly, AI Product Designer',
} = Astro.props;
---

<div class="glitch-portrait">
  <div class="glitch-portrait__stage">
    <img
      class="glitch-portrait__layer glitch-portrait__layer--cyan"
      src={src}
      alt=""
      aria-hidden="true"
      loading="lazy"
      decoding="async"
      width="480"
      height="480"
    />
    <img
      class="glitch-portrait__layer glitch-portrait__layer--magenta"
      src={src}
      alt=""
      aria-hidden="true"
      loading="lazy"
      decoding="async"
      width="480"
      height="480"
    />
    <img
      class="glitch-portrait__layer glitch-portrait__layer--yellow"
      src={src}
      alt=""
      aria-hidden="true"
      loading="lazy"
      decoding="async"
      width="480"
      height="480"
    />
    <img
      class="glitch-portrait__layer glitch-portrait__layer--red"
      src={src}
      alt=""
      aria-hidden="true"
      loading="lazy"
      decoding="async"
      width="480"
      height="480"
    />
    <img
      class="glitch-portrait__layer glitch-portrait__layer--green"
      src={src}
      alt=""
      aria-hidden="true"
      loading="lazy"
      decoding="async"
      width="480"
      height="480"
    />
    <img
      class="glitch-portrait__base"
      src={src}
      alt={alt}
      loading="lazy"
      decoding="async"
      width="480"
      height="480"
    />
  </div>
</div>

<style>
  .glitch-portrait {
    position: relative;
    aspect-ratio: 1 / 1;
    width: 100%;
    max-width: 24rem;
    border-radius: 1rem;
    overflow: hidden;
    background-color: #00d4ff;
    isolation: isolate;
  }

  .glitch-portrait__stage {
    position: relative;
    width: 100%;
    height: 100%;
    background-color: #00d4ff;
  }

  .glitch-portrait__base,
  .glitch-portrait__layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    pointer-events: none;
    user-select: none;
    -webkit-user-select: none;
    mix-blend-mode: multiply;
  }

  .glitch-portrait__base {
    z-index: 6;
    pointer-events: auto;
    filter: contrast(1.05);
  }

  .glitch-portrait__layer {
    z-index: 1;
    opacity: 0.55;
    will-change: transform, opacity;
  }

  /* RGB split ghosts — white in PNG knocks out to turquoise via multiply */
  .glitch-portrait__layer--cyan {
    z-index: 2;
    filter: contrast(1.05) saturate(1.5) hue-rotate(155deg) brightness(1.02);
    animation: glitch-cyan 5s ease-in-out infinite;
  }

  .glitch-portrait__layer--magenta {
    z-index: 3;
    filter: contrast(1.05) saturate(1.6) hue-rotate(285deg) brightness(1.01);
    animation: glitch-magenta 5.4s ease-in-out infinite;
  }

  .glitch-portrait__layer--yellow {
    z-index: 4;
    filter: contrast(1.03) saturate(1.45) hue-rotate(25deg) brightness(1.03);
    animation: glitch-yellow 4.8s ease-in-out infinite;
  }

  .glitch-portrait__layer--red {
    z-index: 4;
    filter: contrast(1.06) saturate(1.65) hue-rotate(350deg) brightness(1);
    animation: glitch-red 5.8s ease-in-out infinite;
  }

  .glitch-portrait__layer--green {
    z-index: 5;
    filter: contrast(1.04) saturate(1.5) hue-rotate(85deg) brightness(1.02);
    animation: glitch-green 6.2s ease-in-out infinite;
  }

  @keyframes glitch-cyan {
    0%,
    100% {
      transform: translateX(-12px);
      opacity: 0.48;
    }
    25% {
      transform: translateX(-17px);
      opacity: 0.58;
    }
    50% {
      transform: translateX(-8px);
      opacity: 0.4;
    }
    75% {
      transform: translateX(-14px);
      opacity: 0.52;
    }
  }

  @keyframes glitch-magenta {
    0%,
    100% {
      transform: translateX(-7px);
      opacity: 0.44;
    }
    30% {
      transform: translateX(-11px);
      opacity: 0.54;
    }
    60% {
      transform: translateX(-5px);
      opacity: 0.38;
    }
    85% {
      transform: translateX(-9px);
      opacity: 0.5;
    }
  }

  @keyframes glitch-yellow {
    0%,
    100% {
      transform: translateX(13px);
      opacity: 0.42;
    }
    35% {
      transform: translateX(18px);
      opacity: 0.52;
    }
    65% {
      transform: translateX(8px);
      opacity: 0.36;
    }
    90% {
      transform: translateX(15px);
      opacity: 0.48;
    }
  }

  @keyframes glitch-red {
    0%,
    100% {
      transform: translateX(9px);
      opacity: 0.46;
    }
    28% {
      transform: translateX(14px);
      opacity: 0.56;
    }
    55% {
      transform: translateX(6px);
      opacity: 0.38;
    }
    80% {
      transform: translateX(11px);
      opacity: 0.5;
    }
  }

  @keyframes glitch-green {
    0%,
    100% {
      transform: translateX(7px);
      opacity: 0.4;
    }
    40% {
      transform: translateX(11px);
      opacity: 0.5;
    }
    70% {
      transform: translateX(4px);
      opacity: 0.34;
    }
    95% {
      transform: translateX(8px);
      opacity: 0.46;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .glitch-portrait__layer {
      animation: none;
      opacity: 0;
    }
  }
</style>
